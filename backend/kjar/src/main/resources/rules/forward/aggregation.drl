package com.ftn.sbnz.rules.forward;

import com.ftn.sbnz.model.drools.Dumpsite;
import com.ftn.sbnz.model.drools.Notification;
import com.ftn.sbnz.model.drools.feature.City;

rule "Urban risk - single city"
    when
        $d : Dumpsite(riskAssessment.urbanRisk == 0)
        accumulate(
            City($dist : distanceM, $pop : population, distanceM <= 3000) from $d.nearbyFeatures;
            $count : count(1),
            $totalPop : sum($pop)
        )
        eval($count == 1)
    then
        double risk = ($totalPop > 100000 ? 3.0 : $totalPop > 10000 ? 2.0 : 1.0)
                    * (1.0 / (1 + 1500.0 / 300.0));
        modify($d) {
            getRiskAssessment().setUrbanRisk(risk)
        }
        $d.getAffectedPopulations().add("Jedno naselje (" + $totalPop + " stanovnika)");
        logger.info("Urban risk (jedno naselje) = " + risk);
end

rule "Urban cluster risk - multiple cities"
    when
        $d : Dumpsite(riskAssessment.urbanRisk == 0)
        accumulate(
            City($pop : population, distanceM <= 3000) from $d.nearbyFeatures;
            $count : count(1),
            $totalPop : sum($pop)
        )
        eval($count > 1)
    then
        double clusterRisk = 0.5 * Math.log(1 + $d.getAreaSqm()) * 0.6 * $count;
        modify($d) {
            getRiskAssessment().setUrbanRisk(clusterRisk)
        }
        $d.getAffectedPopulations().add($count + " naselja, ukupno " + $totalPop + " stanovnika");
        insert(new Notification("LOCAL_COMMUNITY", "Sve mesne zajednice",
            $d.getId(), "Vise naselja ugrozeno: " + $count + " naselja, " + $totalPop + " stanovnika"));
        logger.info("Urban cluster risk = " + clusterRisk + " (" + $count + " naselja)");
end

rule "Water aggregation - river and lake"
    when
        $d : Dumpsite(riskAssessment.riverRisk > 0, 
                      riskAssessment.lakeRisk > 0,
                      riskAssessment.waterAggregated == false)
    then
        double combined = $d.getRiskAssessment().getRiverRisk()
                        + $d.getRiskAssessment().getLakeRisk() * 1.2;
        modify($d) {
            getRiskAssessment().setRiverRisk(combined),
            getRiskAssessment().setWaterAggregated(true)
        }
        insert(new Notification("WATER_COMPANY", "Javno preduzece za vode",
            $d.getId(), "Kombinovani vodni rizik: " + combined));
        logger.info("Water aggregation = " + combined);
end

rule "Compute total risk"
    salience -10
    when
        $d : Dumpsite(riskAssessment.totalRisk == 0)
    then
        modify($d) {
            getRiskAssessment().computeTotal()
        }
        logger.info("Total risk = " + $d.getRiskAssessment().getTotalRisk());
end