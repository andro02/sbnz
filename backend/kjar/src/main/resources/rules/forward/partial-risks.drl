package com.ftn.sbnz.rules.forward;

import com.ftn.sbnz.model.drools.Dumpsite;
import com.ftn.sbnz.model.drools.Notification;
import com.ftn.sbnz.model.drools.RiskLevel;
import com.ftn.sbnz.model.drools.feature.River;
import com.ftn.sbnz.model.drools.feature.Lake;
import com.ftn.sbnz.model.drools.feature.City;
import com.ftn.sbnz.model.drools.feature.Road;
import com.ftn.sbnz.model.drools.feature.School;
import com.ftn.sbnz.model.drools.feature.IndustrialZone;

global org.slf4j.Logger logger;

rule "River risk"
    when
        $d : Dumpsite(riskAssessment.riverCalculated == false)
        $r : River(distanceM <= 5000) from $d.nearbyFeatures
    then
        double risk = $r.computeRisk();
        modify($d) {
            getRiskAssessment().setRiverRisk(risk),
            getRiskAssessment().setRiverCalculated(true),
            setWaterRiskFlag(true)
        }
        logger.info("River risk = " + risk + " for " + $d.getId());
end

rule "Lake risk"
    when
        $d : Dumpsite(riskAssessment.lakeRisk == 0)
        $l : Lake(distanceM <= 3000) from $d.nearbyFeatures
    then
        double risk = $l.computeRisk();
        modify($d) {
            getRiskAssessment().setLakeRisk(risk)
        }
        $d.getThreatenedWaterBodies().add($l.getName());
        logger.info("Lake risk = " + risk);
end

rule "Size risk"
    when
        $d : Dumpsite(riskAssessment.sizeRisk == 0)
    then
        double risk = Math.log(1 + $d.getAreaSqm()) * 0.5;
        modify($d) {
            getRiskAssessment().setSizeRisk(risk)
        }
        logger.info("Size risk = " + risk);
end

rule "Road risk - accessible"
    when
        $d : Dumpsite(riskAssessment.roadCalculated == false)
        $road : Road(distanceM <= 1000, mainRoad == true) from $d.nearbyFeatures
    then
        double risk = 1.0 / (1 + $road.getDistanceM() / 100.0);
        modify($d) {
            getRiskAssessment().setRoadRisk(risk),
            getRiskAssessment().setRoadCalculated(true),
            setAccessPossible(true)
        }
        logger.info("Road risk = " + risk + ", pristup moguc");
end

rule "Accessibility penalty - no road nearby"
    when
        $d : Dumpsite(accessPossible == false)
        accumulate(
            Road($dist : distanceM) from $d.nearbyFeatures;
            $minDist : min($dist)
        )
        eval($minDist.doubleValue() > 200)
    then
        double penalty = $minDist.doubleValue() > 500 ? 5 : $minDist.doubleValue() > 300 ? 3 : 1;
        modify($d) {
            getRiskAssessment().setAccessibilityPenalty(penalty)
        }
        logger.info("Accessibility penalty = " + penalty + ", najblizi put na " + $minDist + "m");
end

rule "Sensitive population risk - school"
    when
        $d : Dumpsite()
        $s : School(distanceM <= 2000) from $d.nearbyFeatures
    then
        double risk = 1.5 * (1.0 / (1 + $s.getDistanceM() / 400.0));
        modify($d) {
            getRiskAssessment().setSensPopRisk(risk)
        }
        insert(new Notification("LOCAL_COMMUNITY", "Nadlezna mesna zajednica",
            $d.getId(), "Skola u blizini deponije - potrebno obavestenje!"));
        logger.info("Sensitive population risk = " + risk);
end

rule "Industry risk"
    when
        $d : Dumpsite()
        accumulate(
            IndustrialZone($h : hazardLevel, distanceM <= 2000) from $d.nearbyFeatures;
            $avgHazard : average($h),
            $count : count(1)
        )
        eval($count > 0)
    then
        double risk = 0.9 * ($avgHazard / 10.0) * $count;
        modify($d) {
            getRiskAssessment().setIndustryRisk(risk)
        }
        insert(new Notification("POLLUTION_REGISTRY", "Registar zagadjivaca",
            $d.getId(), "Dodati deponiju u registar zagadjivaca (" + $count + " industrijskih zona)"));
        logger.info("Industry risk = " + risk + " (" + $count + " zona, avg hazard " + $avgHazard + ")");
end