package com.ftn.sbnz.rules.backward;

import com.ftn.sbnz.model.SanitationPrerequisite;
import com.ftn.sbnz.model.Dumpsite;
import com.ftn.sbnz.model.LogisticsOrder;
import com.ftn.sbnz.model.MissingPrerequisite;
import com.ftn.sbnz.model.FulfilledPrerequisite;

query isPrerequisiteOf(String x, String y)
    SanitationPrerequisite(x, y;)
    or
    (SanitationPrerequisite(z, y;) and isPrerequisiteOf(x, z;))
end

rule "Insert prerequisite iz naloga"
    salience 100
    when
        $d : Dumpsite(riskAssessment.riskLevel != null)
        $o : LogisticsOrder(dumpsiteId == $d.id)
        $prereq : String() from $o.requiredPrerequisites
        not SanitationPrerequisite($prereq, "SanacijaDeponije";)
    then
        insert(new SanitationPrerequisite($prereq, "SanacijaDeponije"));
        System.out.println("[Backward] Insertovan preduslov: " + $prereq);
end

rule "Detektuj nedostajuce preduslove za sanaciju"
    when
        $d : Dumpsite($id : id, riskAssessment.riskLevel != null)
        isPrerequisiteOf($component, "SanacijaDeponije";)
        not FulfilledPrerequisite(name == $component)
        not MissingPrerequisite(dumpsiteId == $id, prerequisiteName == $component)
    then
        insert(new MissingPrerequisite($id, $component));
        System.out.println("[Backward] Deponija " + $id +
            ": nedostaje preduslov '" + $component + "'");
end