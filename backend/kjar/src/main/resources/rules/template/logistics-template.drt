template header
NivoRizika
Pristupacnost
Rok
Mehanizacija
Budzet

package com.ftn.sbnz.rules.template;

import com.ftn.sbnz.model.drools.Dumpsite;
import com.ftn.sbnz.model.drools.RiskLevel;
import com.ftn.sbnz.model.drools.LogisticsOrder;

template "LogistikaSanacije"

rule "Planiranje resursa - @{NivoRizika} - @{Pristupacnost}"
    salience -35
    when
        $d : Dumpsite(
            riskAssessment.riskLevel == RiskLevel.@{NivoRizika},
            accessPossible == @{Pristupacnost}
        )
    then
        LogisticsOrder order = new LogisticsOrder();
        order.setDumpsiteId($d.getId());
        order.setDeadlineDays(@{Rok});
        order.setMehanization("@{Mehanizacija}");
        order.setBudgetCategory("@{Budzet}");
        insert(order);
        System.out.println("Generisan nalog: @{NivoRizika} / @{Pristupacnost} -> @{Mehanizacija}");
end

end template