package com.ftn.sbnz.rules.cep;

import com.ftn.sbnz.model.DumpsiteDetectionEvent;
import com.ftn.sbnz.model.Notification;

declare DumpsiteDetectionEvent
    @role(event)
    @timestamp(detectedAt)
end

rule "CEP - Cluster: vise deponija u istoj regiji za 24h"
    when
        $e1 : DumpsiteDetectionEvent($region : region, $id1 : dumpsiteId)
        $e2 : DumpsiteDetectionEvent(region == $region,
                                      dumpsiteId != $id1,
                                      this after[0, 24h] $e1)
        $e3 : DumpsiteDetectionEvent(region == $region,
                                      dumpsiteId != $id1,
                                      dumpsiteId != $e2.dumpsiteId,
                                      this after[0, 24h] $e1)
    then
        insert(new Notification("ENV_AGENCY", "Agencija za zastitu zivotne sredine",
            $id1, "UPOZORENJE: 3+ deponije detektovane u regiji " + $region + " za 24h!"));
        System.out.println("CEP: Klaster deponija u regiji " + $region);
end

rule "CEP - Ekoloski rizik: deponija blizu rijeke"
    when
        $e : DumpsiteDetectionEvent(nearRiver == true)
        not Notification(dumpsiteId == $e.dumpsiteId, type == "CEP_RIVER")
    then
        insert(new Notification("CEP_RIVER", "Inspekcija za vode",
            $e.getDumpsiteId(),
            "CEP: Nova deponija detektovana u blizini rijeke - hitan ekološki rizik!"));
        System.out.println("CEP: Deponija blizu rijeke - " + $e.getDumpsiteId());
end

rule "CEP - Ekoloski rizik: deponija blizu naselja"
    when
        $e : DumpsiteDetectionEvent(nearCity == true)
        not Notification(dumpsiteId == $e.dumpsiteId, type == "CEP_CITY")
    then
        insert(new Notification("CEP_CITY", "Lokalna samouprava",
            $e.getDumpsiteId(),
            "CEP: Nova deponija detektovana u blizini naselja - obavijestiti stanovnistvo!"));
        System.out.println("CEP: Deponija blizu naselja - " + $e.getDumpsiteId());
end